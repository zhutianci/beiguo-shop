{
  "package": "WP5",
  "note": "WP5 新增的超管接口清单（实施分包 8.4）。全部 adminGuard（主站店面 + 同源 + 查库复核 ADMIN），渠道 Host 上一律 404（T4）；无 partner 路由。key = 寻址键（超管侧用内部 id）；idempotency = 幂等来源。merge-routes.mjs（WP8）与 src/app/api/admin/{tenants,statements,audit}/** 实际目录比对。",
  "routes": [
    { "method": "GET", "path": "/api/admin/tenants", "file": "src/app/api/admin/tenants/route.ts", "guard": "adminGuard", "key": null },
    { "method": "POST", "path": "/api/admin/tenants", "file": "src/app/api/admin/tenants/route.ts", "guard": "adminGuard", "key": null, "idempotency": "code 唯一" },
    { "method": "GET", "path": "/api/admin/tenants/[id]", "file": "src/app/api/admin/tenants/[id]/route.ts", "guard": "adminGuard", "key": "tenantId" },
    { "method": "PATCH", "path": "/api/admin/tenants/[id]", "file": "src/app/api/admin/tenants/[id]/route.ts", "guard": "adminGuard", "key": "tenantId" },
    { "method": "GET", "path": "/api/admin/tenants/[id]/domains", "file": "src/app/api/admin/tenants/[id]/domains/route.ts", "guard": "adminGuard", "key": "tenantId" },
    { "method": "POST", "path": "/api/admin/tenants/[id]/domains", "file": "src/app/api/admin/tenants/[id]/domains/route.ts", "guard": "adminGuard", "key": "tenantId", "idempotency": "host 唯一" },
    { "method": "GET", "path": "/api/admin/tenants/[id]/members", "file": "src/app/api/admin/tenants/[id]/members/route.ts", "guard": "adminGuard", "key": "tenantId" },
    { "method": "PATCH", "path": "/api/admin/tenants/[id]/members", "file": "src/app/api/admin/tenants/[id]/members/route.ts", "guard": "adminGuard", "key": "tenantId+userId" },
    { "method": "GET", "path": "/api/admin/tenants/[id]/invites", "file": "src/app/api/admin/tenants/[id]/invites/route.ts", "guard": "adminGuard", "key": "tenantId" },
    { "method": "POST", "path": "/api/admin/tenants/[id]/invites", "file": "src/app/api/admin/tenants/[id]/invites/route.ts", "guard": "adminGuard", "key": "tenantId" },
    { "method": "PATCH", "path": "/api/admin/tenants/[id]/invites", "file": "src/app/api/admin/tenants/[id]/invites/route.ts", "guard": "adminGuard", "key": "tenantId+inviteId", "idempotency": "CAS usedAt/revokedAt IS NULL" },
    { "method": "GET", "path": "/api/admin/tenants/[id]/payee", "file": "src/app/api/admin/tenants/[id]/payee/route.ts", "guard": "adminGuard", "key": "tenantId" },
    { "method": "PUT", "path": "/api/admin/tenants/[id]/payee", "file": "src/app/api/admin/tenants/[id]/payee/route.ts", "guard": "adminGuard", "key": "tenantId" },
    { "method": "POST", "path": "/api/admin/tenants/[id]/payee", "file": "src/app/api/admin/tenants/[id]/payee/route.ts", "guard": "adminGuard", "key": "tenantId", "note": "查看明文，写审计" },
    { "method": "GET", "path": "/api/admin/tenants/[id]/listings", "file": "src/app/api/admin/tenants/[id]/listings/route.ts", "guard": "adminGuard", "key": "tenantId" },
    { "method": "PUT", "path": "/api/admin/tenants/[id]/listings", "file": "src/app/api/admin/tenants/[id]/listings/route.ts", "guard": "adminGuard", "key": "tenantId+productId", "idempotency": "CAS supplyVersion" },
    { "method": "POST", "path": "/api/admin/tenants/[id]/listings/batch/preview", "file": "src/app/api/admin/tenants/[id]/listings/batch/preview/route.ts", "guard": "adminGuard", "key": "tenantId" },
    { "method": "POST", "path": "/api/admin/tenants/[id]/listings/batch/commit", "file": "src/app/api/admin/tenants/[id]/listings/batch/commit/route.ts", "guard": "adminGuard", "key": "previewToken", "idempotency": "逐行 CAS supplyVersion；重复提交 unchanged" },
    { "method": "GET", "path": "/api/admin/tenants/[id]/ledger", "file": "src/app/api/admin/tenants/[id]/ledger/route.ts", "guard": "adminGuard", "key": "tenantId" },
    { "method": "GET", "path": "/api/admin/tenants/[id]/balances", "file": "src/app/api/admin/tenants/[id]/balances/route.ts", "guard": "adminGuard", "key": "tenantId" },
    { "method": "POST", "path": "/api/admin/tenants/[id]/adjust", "file": "src/app/api/admin/tenants/[id]/adjust/route.ts", "guard": "adminGuard", "key": "tenantId", "idempotency": "adj:{requestId}" },
    { "method": "POST", "path": "/api/admin/tenants/[id]/deposit", "file": "src/app/api/admin/tenants/[id]/deposit/route.ts", "guard": "adminGuard", "key": "tenantId", "idempotency": "dep-in / dep-refund / repay:{流水号}，dep-apply:{requestId}" },
    { "method": "POST", "path": "/api/admin/tenants/[id]/writeoff", "file": "src/app/api/admin/tenants/[id]/writeoff/route.ts", "guard": "adminGuard", "key": "tenantId", "idempotency": "wo:{requestId}" },
    { "method": "GET", "path": "/api/admin/tenants/[id]/statements", "file": "src/app/api/admin/tenants/[id]/statements/route.ts", "guard": "adminGuard", "key": "tenantId" },
    { "method": "POST", "path": "/api/admin/tenants/[id]/statements", "file": "src/app/api/admin/tenants/[id]/statements/route.ts", "guard": "adminGuard", "key": "tenantId", "idempotency": "TenantStatement.requestId 唯一 + openKey 唯一" },
    { "method": "GET", "path": "/api/admin/statements/[sid]", "file": "src/app/api/admin/statements/[sid]/route.ts", "guard": "adminGuard", "key": "statementId" },
    { "method": "POST", "path": "/api/admin/statements/[sid]/paying", "file": "src/app/api/admin/statements/[sid]/paying/route.ts", "guard": "adminGuard", "key": "statementId", "idempotency": "CAS state" },
    { "method": "POST", "path": "/api/admin/statements/[sid]/unpaying", "file": "src/app/api/admin/statements/[sid]/unpaying/route.ts", "guard": "adminGuard", "key": "statementId", "idempotency": "CAS state" },
    { "method": "POST", "path": "/api/admin/statements/[sid]/payout", "file": "src/app/api/admin/statements/[sid]/payout/route.ts", "guard": "adminGuard", "key": "statementId", "idempotency": "TenantPayout.statementId / externalTradeNo 唯一" },
    { "method": "POST", "path": "/api/admin/statements/[sid]/return", "file": "src/app/api/admin/statements/[sid]/return/route.ts", "guard": "adminGuard", "key": "statementId", "idempotency": "CAS state + ret:{sid}" },
    { "method": "POST", "path": "/api/admin/statements/[sid]/bounce", "file": "src/app/api/admin/statements/[sid]/bounce/route.ts", "guard": "adminGuard", "key": "statementId", "idempotency": "bounce:{流水号}" },
    { "method": "GET", "path": "/api/admin/statements/[sid]/proof", "file": "src/app/api/admin/statements/[sid]/proof/route.ts", "guard": "adminGuard", "key": "statementId" },
    { "method": "POST", "path": "/api/admin/statements/[sid]/proof", "file": "src/app/api/admin/statements/[sid]/proof/route.ts", "guard": "adminGuard", "key": "statementId", "idempotency": "CAS proofFile IS NULL" },
    { "method": "GET", "path": "/api/admin/statements/[sid]/export", "file": "src/app/api/admin/statements/[sid]/export/route.ts", "guard": "adminGuard", "key": "statementId" },
    { "method": "POST", "path": "/api/admin/statements/[sid]/payee", "file": "src/app/api/admin/statements/[sid]/payee/route.ts", "guard": "adminGuard", "key": "statementId", "note": "查看快照账号明文，写审计" },
    { "method": "GET", "path": "/api/admin/tenants/reconcile", "file": "src/app/api/admin/tenants/reconcile/route.ts", "guard": "adminGuard", "key": null },
    { "method": "POST", "path": "/api/admin/tenants/reconcile", "file": "src/app/api/admin/tenants/reconcile/route.ts", "guard": "adminGuard", "key": null },
    { "method": "GET", "path": "/api/admin/tenants/overview", "file": "src/app/api/admin/tenants/overview/route.ts", "guard": "adminGuard", "key": null },
    { "method": "GET", "path": "/api/admin/audit", "file": "src/app/api/admin/audit/route.ts", "guard": "adminGuard", "key": null }
  ]
}
