generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id           Int      @id @default(autoincrement())
  phone        String?  @unique @db.VarChar(20)
  email        String?  @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  nickname     String?  @db.VarChar(50)
  avatar       String?  @db.VarChar(255)
  balance      Decimal  @default(0) @db.Decimal(10, 2)
  referralCode String?  @unique @map("referral_code") @db.VarChar(20) // 内推码
  vipLevel     Int      @default(0) @map("vip_level")
  role         UserRole @default(USER)
  status       Int      @default(1) // 1: 正常 0: 禁用
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orders        Order[]
  gameScores    GameScore[]
  forumPosts    ForumPost[]
  forumComments ForumComment[]
  forumLikes    ForumLike[]
  boundAccounts UserAccount[]

  @@map("users")
}

// 用户绑定的订阅账户（Claude / ChatGPT 邮箱），用于在个人中心管理
model UserAccount {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  accountEmail String   @map("account_email") @db.VarChar(255) // 绑定的 Claude/ChatGPT 邮箱（关联 ExternalOrder.claudeAccount）
  platform     String   @default("CLAUDE") @db.VarChar(20) // CLAUDE | CHATGPT | OTHER
  label        String?  @db.VarChar(50) // 备注名（可选）
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountEmail])
  @@index([accountEmail])
  @@map("user_accounts")
}

enum UserRole {
  USER
  ADMIN
}

// 商品分类表
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  icon      String?  @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  status    Int      @default(1) // 1: 启用 0: 禁用
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

// 商品表
model Product {
  id                Int      @id @default(autoincrement())
  categoryId        Int      @map("category_id")
  name              String   @db.VarChar(100)
  description       String?  @db.Text
  price             Decimal  @db.Decimal(10, 2)
  originalPrice     Decimal? @map("original_price") @db.Decimal(10, 2)
  image             String?  @db.VarChar(255)
  stock             Int      @default(-1) // -1表示无限库存
  sales             Int      @default(0)
  sortOrder         Int      @default(0) @map("sort_order")
  status            Int      @default(1) // 1: 上架 0: 下架
  deliveryType      String   @default("MANUAL") @map("delivery_type") @db.VarChar(20) // MANUAL 手工发货 | AUTO 卡密自动发货 | SMS 短信接码
  smsService        String?  @map("sms_service") @db.VarChar(40) // 接码：hero-sms 服务代码（如 OpenAI）
  smsCountry        String?  @map("sms_country") @db.VarChar(40) // 接码：hero-sms 国家/卡类代码（如美国物理卡）
  smsMaxPrice       Decimal? @map("sms_max_price") @db.Decimal(10, 2) // 接码：取号最高价 maxPrice
  referrerBasePrice Decimal? @map("referrer_base_price") @db.Decimal(10, 2) // 推广人默认基础价（进货价；null 则用网站售价）
  cardUsage         String?  @map("card_usage") @db.Text // 自动发货使用说明（含售后），展示给买家
  cardRedeemUrl     String?  @map("card_redeem_url") @db.VarChar(500) // 充值/兑换链接，买家拿到卡密后可一键跳转
  apiSku            String?  @unique @map("api_sku") @db.VarChar(64) // 对外发卡编码：外部站点按此调库存 API 领卡，共用同一批卡密（仅 AUTO 有意义）
  features          String?  @db.Text // JSON格式存储商品特性
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  category Category  @relation(fields: [categoryId], references: [id])
  orders   Order[]
  cardKeys CardKey[]

  @@map("products")
}

// 卡密（自动发货）：内容加密存储，仅订单所有者/管理员可解密查看
model CardKey {
  id             Int       @id @default(autoincrement())
  productId      Int       @map("product_id")
  content        String    @db.Text // AES-256-GCM 加密后的卡密（iv:tag:cipher，base64）
  contentHash    String    @map("content_hash") @db.VarChar(64) // sha256(明文+盐)，用于同商品内去重，不可逆
  status         String    @default("UNUSED") @db.VarChar(20) // UNUSED 未使用 | USED 已发出 | DISABLED 已停用
  orderId        Int?      @map("order_id") // 被本站哪个订单消费（外部站点发卡为空，改看 externalRef）
  externalRef    String?   @map("external_ref") @db.VarChar(120) // 外部站点发卡归属：<client>:<orderNo>；本地订单为空
  usedAt         DateTime? @map("used_at") // 发出时间（createdAt 是创建/导入时间，两者语义不同，勿合并）
  batch          String?   @db.VarChar(40)
  remark         String?   @db.VarChar(255)
  // ---- 成本 / 利润（落库，不在列表现算）----
  cost           Decimal?  @db.Decimal(10, 2) // 进货成本，批量导入时按批录入；历史卡回填为 0
  soldPrice      Decimal?  @map("sold_price") @db.Decimal(10, 2) // 发出时的单卡售价快照；外部站发卡拿不到售价，保持 null
  profit         Decimal?  @db.Decimal(10, 2) // = soldPrice - cost；null 表示「利润未知」，不要写 0
  redeemUrl      String?   @map("redeem_url") @db.VarChar(500) // 本批专属兑换地址；为空则回落 Product.cardRedeemUrl
  // 站内兑换用的充值平台标识（lib/redeem/registry.ts 里的 key，如 sysa）。
  // 优先级：redeemProvider（站内兑换页）> redeemUrl（跳转外链）> Product.cardRedeemUrl。
  // 值一旦写入就不能改动对应适配器的 key，否则历史卡密会找不到适配器。
  redeemProvider String?   @map("redeem_provider") @db.VarChar(20)
  // 「这张卡已经被提交给上游、可能已经消耗」的原子占位时间戳。
  //
  // 【为什么必须有这一列】走 V2 时，防重复扣卡靠的是上游按 order_id 去重；
  // 但卡付通道改走 V1 之后（见 lib/redeem/providers/sysb-card-v1.ts），
  // V1 **没有任何幂等键** —— 同一张卡并发提交两次就是两笔真实扣款。
  // 唯一能挡住它的是我们自己先做一次原子占位：
  //   UPDATE card_keys SET redeem_lock_at=? WHERE id=? AND redeem_lock_at IS NULL
  // 受影响行数为 1 才算抢到。这件事没有别的列可以借用 ——
  // externalRef 已经是外部站发卡的归属，含义完全不同，不能挪用。
  //
  // 占位写在 precheckAccount **之前**：上游的注释写明 prepare gate 会在
  // 「reserving a card」之前校验登录，也就是 precheck 一成功卡就被预留了。
  redeemLockAt   DateTime? @map("redeem_lock_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, contentHash])
  @@index([productId, status])
  @@index([orderId])
  @@index([externalRef])
  @@index([status, usedAt]) // 每日成本/利润按发出时间区间聚合
  @@index([productId, batch]) // 按批次批量改成本
  // 兑换页要凭卡密明文的哈希反查这张卡是不是我们卖出去的。
  // 既有的 @@unique([productId, contentHash]) 前导列是 productId，
  // 单独按 contentHash 查用不上它 —— 没有这个索引就是每次兑换全表扫。
  @@index([contentHash])
  @@map("card_keys")
}

// 外部站点发卡记录（共用库存）：唯一(client, externalNo) 做幂等闸，防同一外部订单重复领卡
model ExternalDispense {
  id         Int      @id @default(autoincrement())
  client     String   @db.VarChar(40) // 调用方标识（哪个站，如 "site2"）
  externalNo String   @map("external_no") @db.VarChar(64) // 外部站订单号（幂等键）
  productId  Int      @map("product_id")
  apiSku     String?  @map("api_sku") @db.VarChar(64)
  quantity   Int // 首次请求确定的应发数量（后续须一致）
  delivered  Int      @default(0) // 已成功发出的卡密数
  cardIds    String   @default("") @map("card_ids") @db.VarChar(1000) // 发出的 CardKey id，逗号分隔（审计用）
  status     String   @default("PENDING") @db.VarChar(20) // PENDING 待处理 | PROCESSING 发卡中(锁) | FULFILLED 已足额 | PARTIAL 库存不足/待补
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([client, externalNo])
  @@index([productId])
  @@map("external_dispenses")
}

// 订单表
model Order {
  id             Int            @id @default(autoincrement())
  orderNo        String         @unique @map("order_no") @db.VarChar(32)
  userId         Int            @map("user_id")
  productId      Int            @map("product_id")
  productName    String         @map("product_name") @db.VarChar(100)
  productPrice   Decimal        @map("product_price") @db.Decimal(10, 2)
  quantity       Int            @default(1)
  amount         Decimal        @db.Decimal(10, 2)
  payMethod      PayMethod?     @map("pay_method")
  payStatus      PayStatus      @default(UNPAID) @map("pay_status")
  deliveryStatus DeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryInfo   String?        @map("delivery_info") @db.Text // 交付信息（如账号密码）
  remark         String?        @db.VarChar(255)
  referrerId     Int?           @map("referrer_id") // 内推：推广人用户ID
  referralReward Decimal?       @map("referral_reward") @db.Decimal(10, 2) // 内推返现金额快照（= 专属价−基础售价）
  // ---- 优惠券 ----
  // amount 记录的是**优惠后**的实付价（站长要求）。原价与减免额单独留痕，
  // 否则后台看到一个比商品定价低的数字，无法区分是内推专属价还是用了券。
  couponGrantId  Int?           @map("coupon_grant_id") // 用掉的券实例
  couponDiscount Decimal?       @map("coupon_discount") @db.Decimal(10, 2) // 本单减免额快照
  originalAmount Decimal?       @map("original_amount") @db.Decimal(10, 2) // 未用券时应付的金额
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  paidAt         DateTime?      @map("paid_at")
  deliveredAt    DateTime?      @map("delivered_at")

  user     User           @relation(fields: [userId], references: [id])
  product  Product        @relation(fields: [productId], references: [id])
  payments Payment[]
  messages OrderMessage[]

  @@index([referrerId])
  @@index([createdAt]) // 后台订单列表 orderBy createdAt desc + skip 深翻页
  @@index([payStatus, paidAt]) // 按到账日聚合
  @@map("orders")
}

// 订单聊天消息（每订单唯一标识；买家在订单内、卖家在后台回复）
model OrderMessage {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  sender      String   @db.VarChar(10) // BUYER | ADMIN
  content     String   @db.Text
  readByAdmin Boolean  @default(false) @map("read_by_admin")
  readByBuyer Boolean  @default(false) @map("read_by_buyer")
  createdAt   DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_messages")
}

// 短信接码会话（每订单一个；对接 hero-sms）
model SmsActivation {
  id           Int       @id @default(autoincrement())
  orderId      Int       @unique @map("order_id")
  activationId String    @map("activation_id") @db.VarChar(64) // hero-sms 取号 ID
  phone        String    @db.VarChar(40)
  service      String    @db.VarChar(40)
  country      String    @db.VarChar(40)
  status       String    @default("WAITING") @db.VarChar(20) // WAITING 等码 | CODE 已收码 | TIMEOUT 超时 | CANCELLED 取消 | FAILED 取号失败
  code         String?   @db.VarChar(255)
  cost         Decimal?  @db.Decimal(10, 2)
  raw          String?   @db.Text // 最近一次原始返回，便于排查
  expireAt     DateTime  @map("expire_at")
  codeAt       DateTime? @map("code_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("sms_activations")
}

// 用户余额变动流水（内推返现入账 / 管理员调整 / 提现扣减）
model BalanceLog {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  delta        Decimal  @db.Decimal(10, 2) // 变动额：正=增加，负=提现/扣减
  balanceAfter Decimal  @map("balance_after") @db.Decimal(10, 2)
  type         String   @db.VarChar(20) // REFERRAL | ADJUST | WITHDRAW
  note         String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("balance_logs")
}

// 内推：推广人为某商品设置的专属价格
model ReferralPrice {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  price     Decimal  @db.Decimal(10, 2) // 专属价（≥ 基础售价）
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@index([userId])
  @@map("referral_prices")
}

// 推广人专属基础价（进货价）：管理员为重量级推广人单独设置，覆盖商品默认
model ReferrerBasePrice {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@index([userId])
  @@map("referrer_base_prices")
}

// 内推返现记录（订单已完成后产生，金额= 专属价−推广人基础价，自动进推广人余额）
model ReferralReward {
  id         Int       @id @default(autoincrement())
  orderId    Int       @unique @map("order_id")
  referrerId Int       @map("referrer_id")
  buyerId    Int       @map("buyer_id")
  productId  Int       @map("product_id")
  amount     Decimal   @db.Decimal(10, 2)
  status     String    @default("SETTLED") @db.VarChar(20) // SETTLED 已结算(入余额) | CANCELLED
  createdAt  DateTime  @default(now()) @map("created_at")
  settledAt  DateTime? @map("settled_at")

  @@index([referrerId])
  @@index([status])
  @@map("referral_rewards")
}

enum PayMethod {
  ALIPAY
  WECHAT
  BALANCE
}

enum PayStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  CANCELLED
}

// 支付记录表
model Payment {
  id           Int       @id @default(autoincrement())
  orderId      Int       @map("order_id")
  tradeNo      String?   @map("trade_no") @db.VarChar(64) // 第三方支付流水号
  payMethod    PayMethod @map("pay_method")
  amount       Decimal   @db.Decimal(10, 2)
  status       Int       @default(0) // 0: 待支付 1: 成功 2: 失败
  callbackData String?   @map("callback_data") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// 外部订单（从腾讯文档批量导入）
model ExternalOrder {
  id                 Int       @id @default(autoincrement())
  startDate          DateTime  @map("start_date") @db.Date // 开通时间
  expireDate         DateTime  @map("expire_date") @db.Date // 到期时间（开通时间 + 1 个月）
  subscriptionType   String    @map("subscription_type") @db.VarChar(100) // 订阅类型
  xianyuNickname     String?   @map("xianyu_nickname") @db.VarChar(100) // 闲鱼昵称
  claudeAccount      String    @map("claude_account") @db.VarChar(255) // 账户邮箱
  cost               Decimal?  @db.Decimal(10, 2) // 本单成本
  quote              Decimal?  @db.Decimal(10, 2) // 报价
  profit             Decimal?  @db.Decimal(10, 2) // 利润（默认 = 报价 - 成本，可手填）
  sourceKey          String    @unique @map("source_key") @db.VarChar(128) // 去重键
  importBatch        String?   @map("import_batch") @db.VarChar(32)
  remindedExpireDate DateTime? @map("reminded_expire_date") @db.Date // 已提醒过的到期日（用于跳过自动提醒；续费后到期日变化即重新生效）
  lastRemindedAt     DateTime? @map("last_reminded_at") // 最后一次提醒时间（含手动）
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  reminderLogs ReminderLog[]

  @@index([claudeAccount])
  @@index([expireDate])
  @@map("external_orders")
}

// 账户联系方式（用户在前台自助填写，决定到期提醒发到哪里）
model AccountContact {
  id            Int      @id @default(autoincrement())
  claudeAccount String   @unique @map("claude_account") @db.VarChar(255) // 关联 ExternalOrder.claudeAccount
  email         String?  @db.VarChar(255) // 邮箱提醒地址（默认 = Claude 账户邮箱）
  phone         String?  @db.VarChar(20) // 短信提醒手机号
  notifyEmail   Boolean  @default(true) @map("notify_email") // 是否启用邮箱提醒
  notifyPhone   Boolean  @default(false) @map("notify_phone") // 是否启用短信提醒
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("account_contacts")
}

// 提醒发送记录
model ReminderLog {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  claudeAccount String   @map("claude_account") @db.VarChar(255)
  channel       String   @db.VarChar(20) // email | sms
  target        String   @db.VarChar(255) // 实际发送到的邮箱 / 手机号
  trigger       String   @db.VarChar(20) // auto | manual
  status        String   @db.VarChar(20) // success | failed
  detail        String?  @db.Text // 错误信息或回执 RequestId
  createdAt     DateTime @default(now()) @map("created_at")

  order ExternalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([claudeAccount])
  @@index([createdAt])
  @@map("reminder_logs")
}

// 游戏分数排行榜
model GameScore {
  id         Int      @id @default(autoincrement())
  gameId     String   @map("game_id") @db.VarChar(50)
  userId     Int?     @map("user_id")
  playerName String   @map("player_name") @db.VarChar(50)
  score      Int
  duration   Int? // 用时（秒）
  metadata   String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([gameId, score])
  @@index([gameId, createdAt])
  @@map("game_scores")
}

// V免签式收款订单（监控个人收款码到账，按唯一金额匹配）
model VmqOrder {
  id          Int       @id @default(autoincrement())
  orderId     String    @unique @map("order_id") @db.VarChar(40) // 云端订单号（不可枚举）
  bizType     String    @map("biz_type") @db.VarChar(20) // order | invoice
  bizId       Int       @map("biz_id") // Order.id 或 Invoice.id
  outTradeNo  String    @map("out_trade_no") @db.VarChar(40) // 业务单号（orderNo / invoiceNo）
  type        Int       @default(2) // 1 微信 2 支付宝（本项目仅 2）
  price       Decimal   @db.Decimal(10, 2) // 原始应付金额
  reallyPrice Decimal   @map("really_price") @db.Decimal(10, 2) // 实付唯一金额（原价基础上 +0.01 递增）
  state       Int       @default(0) // 0 待支付 1 已支付 -1 已过期
  createdAt   DateTime  @default(now()) @map("created_at")
  payDate     DateTime? @map("pay_date")

  @@index([bizType, bizId, state])
  @@index([state, type])
  @@map("vmq_orders")
}

// 金额占用锁（保证同一时刻同金额唯一；靠唯一约束做原子分配）
model VmqLock {
  id        Int      @id @default(autoincrement())
  lockKey   String   @unique @map("lock_key") @db.VarChar(40) // "<分>-<type>"
  orderId   String   @map("order_id") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("vmq_locks")
}

// 邮箱验证码（注册 / 找回密码）
model EmailCode {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  code      String   @db.VarChar(10)
  purpose   String   @db.VarChar(20) // REGISTER | RESET
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("email_codes")
}

// ============ AI圈大事记 ============
// 规范见 .claude/skills/ai-news-pipeline/SKILL.md。核心设计：把内容建模成【事件】而非【文章】，
// 同一件事聚合多家信源成一条 NewsEvent，时间脉络、跨源热度、版权安全三个问题一次解决。

// 信源
model NewsSource {
  id          Int       @id @default(autoincrement())
  key         String    @unique @db.VarChar(40) // 稳定标识，如 qbitai
  name        String    @db.VarChar(80) // 展示名，如「量子位」
  homepage    String?   @db.VarChar(300)
  feedUrl     String    @db.VarChar(500)
  kind        String    @default("RSS") @db.VarChar(20) // RSS | ATOM | JSON | HN | GITHUB | X
  lang        String    @default("zh") @db.VarChar(10)
  tier        Int       @default(2) // 1 一手官方 | 2 专业媒体 | 3 从业者社区
  role        String    @default("feed") @db.VarChar(10) // feed 产条目 | signal 只加热度 | both
  weight      Decimal   @default(1.00) @db.Decimal(4, 2)
  viaRelay    Boolean   @default(false) @map("via_relay") // 经 Cloudflare Worker 中继（境内直连不通的源）
  enabled     Boolean   @default(true)
  // 运行状态：连续失败会自动禁用并在后台标红
  lastFetchAt DateTime? @map("last_fetch_at")
  lastOkAt    DateTime? @map("last_ok_at")
  failCount   Int       @default(0) @map("fail_count")
  lastError   String?   @map("last_error") @db.VarChar(500)
  itemCount   Int       @default(0) @map("item_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  items NewsItem[]

  @@index([enabled, role])
  @@map("news_sources")
}

// 原始条目：一个信源的一条 feed entry。只存标题与 feed 自带的 description，不抓原文正文。
model NewsItem {
  id               Int      @id @default(autoincrement())
  sourceId         Int      @map("source_id")
  guid             String   @db.VarChar(255)
  url              String   @db.VarChar(1000)
  urlHash          String   @map("url_hash") @db.VarChar(64) // 规范化 URL 的 sha256，用于跨源撞同一篇原文
  title            String   @db.VarChar(500)
  summaryRaw       String?  @map("summary_raw") @db.Text
  author           String?  @db.VarChar(120)
  publishedAt      DateTime @map("published_at")
  fetchedAt        DateTime @default(now()) @map("fetched_at")
  // 分诊结果
  triageState      String   @default("RAW") @map("triage_state") @db.VarChar(20) // RAW|OK|BLOCKED|SKIP|FAILED
  blocked          Boolean  @default(false) // 命中选题黑名单
  blockReason      String?  @map("block_reason") @db.VarChar(200)
  category         String?  @db.VarChar(20)
  entities         String?  @db.Text // JSON string[]，聚类指纹
  confidence       Decimal? @db.Decimal(3, 2)
  // 热度信号（HN points / GitHub stars 等）
  points           Int      @default(0)
  comments         Int      @default(0)
  eventId          Int?     @map("event_id")
  // ---- 线索中介（第三方选题发现信号，见 docs/AIHOT线索接入.md）----
  // 我们**只**从对方拿「去哪儿看」：标题 / 原文链接 / 原发布者名 / 发布时间。
  // 对方写的 summary 与 reason 一个字都不取——那超出授权范围，也违反 SKILL.md §1.1「只能自写摘要」。
  // 所以这类条目的 summaryRaw 天然是 NULL，**这是设计不是 bug**，不要「顺手补上」。
  leadVia          String?  @map("lead_via") @db.VarChar(20) // 线索中介标识，如 'AIHOT'；空 = 我们自己的 feed 直接抓到
  leadUrl          String?  @map("lead_url") @db.VarChar(300) // 授权要求的回链地址，落库前校验 host
  originSourceName String?  @map("origin_source_name") @db.VarChar(120) // 原发布者名，如「公众号：数字生命卡兹克」
  // 为什么 originSourceName 不是可选项：SKILL.md §6 硬要求展示「全部信源的媒体名」。
  // 不落这一列，详情页只能显示中介名「AIHOT」，那是把线索中介冒充成原发布者。

  source NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  event  NewsEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([sourceId, urlHash]) // 刻意不是全局唯一：同一篇原文会同时出现在多个源里
  @@index([triageState, publishedAt])
  @@index([eventId])
  @@index([publishedAt])
  @@index([urlHash])
  @@map("news_items")
}

// 事件：一件事 + 它的全部信源
model NewsEvent {
  id           Int       @id @default(autoincrement())
  slug         String    @unique @db.VarChar(90)
  headline     String    @db.VarChar(300)
  summary      String    @db.Text
  whyItMatters String?   @map("why_it_matters") @db.VarChar(300) // 推荐理由
  facts        String?   @db.Text // JSON [{text, sourceIndex}]，供人工一键复核
  // 全文层：JSON [{heading, body}]，2-4 段带小标题，详情页用。
  // 仍是自写的、不是原文（SKILL.md §1.1），素材来自 compose 抓到的原文正文。
  // 与 summary 的分工：summary 120-260 字给列表卡片，detail 600-1200 字撑详情页。
  detail       String?   @db.Text
  // 全文层的状态机。**刻意与 composeState 分开**：detail 是「可丢弃区块」——
  // 校验不过就不要这一块，事件本身照常发布，不能因为 detail 写砸了把整条判死。
  //   RAW  还没写（老事件默认落在这里，等回填）
  //   DONE 写好了
  //   SKIP 内容性结论：素材不足或校验不过，不再重试（区别于瞬时失败）
  // 瞬时失败（超时/限流/5xx）不写终态，只 detailTries+1 下轮重来——
  // 交接文档第四节踩坑 3「漏答条目被永久判死」就是把瞬时失败写成终态导致 40 条丢 35 条。
  detailState  String    @default("RAW") @map("detail_state") @db.VarChar(20)
  detailTries  Int       @default(0) @map("detail_tries") // 达到上限转 SKIP，防止无终态死循环
  category     String    @default("industry") @db.VarChar(20)
  tags         String?   @db.VarChar(300) // 逗号分隔，取自白名单词表
  aiScore      Int       @default(0) @map("ai_score") // 模型给的重要性 0-100，展示给用户
  // 热度（可解释：每一项独立成列，明细落 scoreDebug）
  score        Decimal   @default(0) @db.Decimal(8, 3)
  // 不含时间衰减的原始分。为什么要单独一列：score 是 Decimal(8,3)，
  // 36 小时半衰期算下来约三周后所有老事件的 score 都 round 成 0.000，
  // 归档页要按热度排就再也排不出先后。baseScore 不随时间变，是老事件唯一稳定的排序键。
  // 可空：历史行为 NULL，由 rank 的冷层每轮补 200 条自愈，不写一次性回填脚本。
  baseScore    Decimal?  @map("base_score") @db.Decimal(8, 3)
  scoreDebug   String?   @map("score_debug") @db.Text
  sourceCount  Int       @default(1) @map("source_count") // 先按 urlHash 去重再数 distinct sourceId
  tier1Count   Int       @default(0) @map("tier1_count")
  hnPoints     Int       @default(0) @map("hn_points")
  viewCount    Int       @default(0) @map("view_count")
  shareCount   Int       @default(0) @map("share_count")
  likeCount    Int       @default(0) @map("like_count")
  // 状态：全自动发布，可疑条目仍发布但不进首页与重点榜
  status       String    @default("PUBLISHED") @db.VarChar(20) // DRAFT|PUBLISHED|UNLISTED
  needsReview  Boolean   @default(false) @map("needs_review")
  reviewNote   String?   @map("review_note") @db.VarChar(300)
  reviewedAt   DateTime? @map("reviewed_at")
  pinned       Boolean   @default(false)
  composeState String    @default("RAW") @map("compose_state") @db.VarChar(20) // RAW|DONE|FAILED
  rewriteCount Int       @default(0) @map("rewrite_count") // 终身最多重写 1 次
  happenedAt   DateTime  @map("happened_at") // 最早信源的发布时间，时间轴按它排
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  items NewsItem[]

  @@index([status, happenedAt])
  @@index([status, score])
  @@index([category, status, happenedAt])
  @@index([composeState])
  // 「最近补录」查的是「happenedAt 很旧、publishedAt 很新」，上面按 happenedAt 的索引帮不上。
  // 注意：现有 @@index([composeState]) 看着像下面这条的前缀冗余，**也不要删** ——
  // 删任何一条现有索引都会让 migrate diff 产出 DROP INDEX，而 deploy.sh 写死了 --accept-data-loss。
  @@index([status, publishedAt])
  @@index([detailState])
  @@map("news_events")
}

// 日报 / 周报
model NewsDigest {
  id          Int      @id @default(autoincrement())
  type        String   @db.VarChar(10) // DAILY | WEEKLY
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  title       String   @db.VarChar(200)
  intro       String?  @db.Text
  eventIds    String   @map("event_ids") @db.Text // JSON number[]，按榜单顺序
  status      String   @default("PUBLISHED") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([type, periodStart]) // 保证重跑幂等
  @@index([type, periodStart])
  @@map("news_digests")
}

// LLM 调用记账：预算闸门与成本审计的依据
model NewsLlmCall {
  id               Int      @id @default(autoincrement())
  stage            String   @db.VarChar(20) // triage|cluster|compose|digest
  provider         String   @db.VarChar(20)
  model            String   @db.VarChar(60)
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  costMilli        Int      @default(0) @map("cost_milli") // 千分之一分，整数避免浮点
  ms               Int      @default(0)
  ok               Boolean  @default(true)
  error            String?  @db.VarChar(300)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([stage, createdAt])
  @@map("news_llm_calls")
}

// 浏览去重：爬虫不执行 JS，前端停留 3 秒后 sendBeacon 上报，按小时桶去重
model NewsView {
  id         Int      @id @default(autoincrement())
  eventId    Int      @map("event_id")
  viewerKey  String   @map("viewer_key") @db.VarChar(64)
  hourBucket String   @map("hour_bucket") @db.VarChar(13) // YYYY-MM-DDTHH
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([eventId, viewerKey, hourBucket])
  @@index([eventId])
  @@index([createdAt])
  @@map("news_views")
}

// 站点公告：后台发布，买家进入前台任意页面时弹窗展示
model Announcement {
  id        Int       @id @default(autoincrement())
  title     String    @db.VarChar(200)
  content   String    @db.Text // 纯文本，换行原样展示
  level     String    @default("INFO") @db.VarChar(20) // INFO 通知 | WARN 警示 | SUCCESS 喜报
  enabled   Boolean   @default(false) // 未启用即不展示
  pinned    Boolean   @default(false) // 强提醒：每次进入都弹，忽略「不再提示」
  startAt   DateTime? @map("start_at") // 生效时间，空=立即
  endAt     DateTime? @map("end_at") // 失效时间，空=长期
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at") // 内容有更新时会重新弹给已读过的买家

  @@index([enabled, startAt, endAt])
  @@map("announcements")
}

// 系统配置表
model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(50)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// 发票申请
model Invoice {
  id               Int       @id @default(autoincrement())
  invoiceNo        String    @unique @map("invoice_no") @db.VarChar(32) // 也用作税费支付的 out_trade_no
  // 关联外部订单（一笔订单一张发票；存快照，避免重导丢失）
  externalOrderId  Int?      @unique @map("external_order_id")
  sourceKey        String?   @map("source_key") @db.VarChar(128)
  claudeAccount    String    @map("claude_account") @db.VarChar(255)
  subscriptionType String    @map("subscription_type") @db.VarChar(100)
  orderStartDate   DateTime? @map("order_start_date") @db.Date
  orderExpireDate  DateTime? @map("order_expire_date") @db.Date
  // 金额（以订单报价 quote 为基准；管理员手动标记状态且订单无报价时可为空）
  sellingPrice     Decimal?  @map("selling_price") @db.Decimal(10, 2) // 售价 = 报价
  invoiceAmount    Decimal?  @map("invoice_amount") @db.Decimal(10, 2) // 开票金额（含税）= 报价 * 1.06
  taxFee           Decimal?  @map("tax_fee") @db.Decimal(10, 2) // 应付税费 = 报价 * 0.06
  // 抬头信息（买家申请时必填；管理员手动改状态/同步生成的记录可为空）
  title            String?   @db.VarChar(200) // 抬头
  taxNumber        String?   @map("tax_number") @db.VarChar(64) // 税号
  address          String?   @db.VarChar(255) // 地址
  phone            String?   @db.VarChar(50) // 电话
  bankName         String?   @map("bank_name") @db.VarChar(128) // 开户行
  bankAccount      String?   @map("bank_account") @db.VarChar(64) // 卡号
  email            String?   @db.VarChar(255) // 接收邮箱
  // 买家申请时必选：发票内容是否展示 ChatGPT/Claude 等字眼。
  // 可空而非 default(true)：历史发票与管理员凭空建的空壳记录应显示「-」，不能误标成买家已选择展示。
  showAiWording    Boolean?  @map("show_ai_wording")
  // 状态：UNAPPLIED 未开发票 / AWAIT_PAY 待支付税费 / SUBMITTED 已提交开票 / ISSUED 已开具 / CANNOT 不可开据
  status           String    @default("UNAPPLIED") @db.VarChar(20)
  // 税费支付
  payStatus        String    @default("UNPAID") @map("pay_status") @db.VarChar(20)
  tradeNo          String?   @map("trade_no") @db.VarChar(64)
  paidAt           DateTime? @map("paid_at")
  submittedAt      DateTime? @map("submitted_at") // 提交开票时间（状态变为 SUBMITTED 时）
  issuedAt         DateTime? @map("issued_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([claudeAccount])
  @@index([status])
  @@map("invoices")
}

// 卡密兑换尝试记录。
//
// 【绝对不存这两样东西】
//  · 卡密明文 —— 只存 cardKeyId，要看卡密去 card_keys 走解密
//  · 买家的账号凭据（Claude sessionKey / ChatGPT session JSON）——
//    那是账号级凭据，落库就是一个等着被拖走的密码库。它只在内存里过一趟就丢掉。
//
// requestId 是上游的追踪号，对方文档明确要求排查时连同卡密一起提供。
model RedeemLog {
  id        Int      @id @default(autoincrement())
  cardKeyId Int?     @map("card_key_id")
  provider  String   @db.VarChar(20)
  action    String   @db.VarChar(16) // CHECK | ACTIVATE | REBIND
  state     String   @db.VarChar(20) // RedeemState
  message   String?  @db.VarChar(255)
  requestId String?  @map("request_id") @db.VarChar(64)
  // 异步下单平台（如 sysb）的上游订单号。它是幂等的锚：
  // 同一张卡重试时必须复用原订单号续查，换新号重下就是重复扣卡。
  orderRef  String?  @map("order_ref") @db.VarChar(64)
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([cardKeyId])
  @@index([createdAt])
  @@map("redeem_logs")
}

// 收据（买家提交抬头后出具，加盖公章；一笔订单仅一张，仅管理员可删除重开）
model Receipt {
  id               Int       @id @default(autoincrement())
  receiptNo        String    @unique @map("receipt_no") @db.VarChar(32)
  token            String?   @unique @db.VarChar(64) // 不可枚举的公开访问令牌
  externalOrderId  Int?      @map("external_order_id")
  sourceKey        String?   @map("source_key") @db.VarChar(128)
  // 手动开具（DIY）的收据没有订阅账户/类型，故两列放宽为可空
  claudeAccount    String?   @map("claude_account") @db.VarChar(255)
  subscriptionType String?   @map("subscription_type") @db.VarChar(100)
  orderStartDate   DateTime? @map("order_start_date") @db.Date
  orderExpireDate  DateTime? @map("order_expire_date") @db.Date
  payerTitle       String    @map("payer_title") @db.VarChar(200) // 付款人（抬头）
  payee            String    @db.VarChar(200) // 收款人
  amount           Decimal   @db.Decimal(10, 2) // 付款金额
  // ---- 来源 / 自定义条目 ----
  source           String    @default("BUYER") @db.VarChar(20) // BUYER 买家提交 | MANUAL 手动开具
  items            String?   @db.Text // JSON: [{label,value}] 有序数组，手动开具的 DIY 条目
  remark           String?   @db.VarChar(500)
  issuedAt         DateTime? @map("issued_at") // 手动开具时可指定的开具时间；为空则用 createdAt
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at") // 必须可空：已有行 ALTER 时无 DB 层 default

  @@index([claudeAccount])
  @@index([externalOrderId])
  @@index([source])
  @@map("receipts")
}

// ============ 论坛 / 社区反馈 ============

// 论坛板块
model ForumCategory {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50)
  slug        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  icon        String?  @db.VarChar(20) // emoji
  color       String?  @db.VarChar(20) // 主题色（tailwind 渐变前缀或 hex）
  sortOrder   Int      @default(0) @map("sort_order")
  status      Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  posts ForumPost[]

  @@map("forum_categories")
}

// 帖子
model ForumPost {
  id           Int       @id @default(autoincrement())
  categoryId   Int       @map("category_id")
  userId       Int?      @map("user_id") // 登录用户；匿名为 null
  authorName   String    @map("author_name") @db.VarChar(50) // 显示名（用户昵称或匿名昵称）
  authorEmail  String?   @map("author_email") @db.VarChar(100) // 匿名可选邮箱（不公开展示）
  title        String    @db.VarChar(200)
  content      String    @db.Text // Markdown
  images       String?   @db.Text // JSON: 图片 URL 数组
  tags         String?   @db.VarChar(255) // 逗号分隔
  pinned       Boolean   @default(false) // 置顶
  featured     Boolean   @default(false) // 精华
  locked       Boolean   @default(false) // 锁帖（禁止回复）
  status       Int       @default(1) // 1 正常 0 隐藏
  views        Int       @default(0)
  likeCount    Int       @default(0) @map("like_count")
  commentCount Int       @default(0) @map("comment_count")
  lastReplyAt  DateTime? @map("last_reply_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  category ForumCategory  @relation(fields: [categoryId], references: [id])
  user     User?          @relation(fields: [userId], references: [id])
  comments ForumComment[]
  likes    ForumLike[]

  @@index([categoryId])
  @@index([status, pinned, lastReplyAt])
  @@index([createdAt])
  @@map("forum_posts")
}

// 评论 / 楼中楼回复
model ForumComment {
  id         Int      @id @default(autoincrement())
  postId     Int      @map("post_id")
  parentId   Int?     @map("parent_id") // 回复某条评论（楼中楼）
  userId     Int?     @map("user_id")
  authorName String   @map("author_name") @db.VarChar(50)
  content    String   @db.Text
  likeCount  Int      @default(0) @map("like_count")
  status     Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")

  post    ForumPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id])
  parent  ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ForumComment[] @relation("CommentReplies")
  likes   ForumLike[]

  @@index([postId])
  @@index([parentId])
  @@map("forum_comments")
}

// 点赞（帖子或评论；登录用 userId，匿名用 anonId 去重）
model ForumLike {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  anonId    String?  @map("anon_id") @db.VarChar(64)
  postId    Int?     @map("post_id")
  commentId Int?     @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User?         @relation(fields: [userId], references: [id])
  post    ForumPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment ForumComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([commentId])
  @@index([userId])
  @@map("forum_likes")
}

// ============ 优惠券 ============
// 设计要点见 docs/优惠券设计.md。三条不可动摇的：
//  ① 一张券只能被用一次 —— 靠 updateMany 的 CAS 条件保证，不是靠先查后写
//  ② 三限（IP/账户/浏览器）靠**唯一约束**保证，不是靠先查后插
//  ③ 与内推不叠加，取对买家更优的一个

// 券批次：后台建一批，生成一条共享领取链接，谁点谁领
model Coupon {
  id         Int       @id @default(autoincrement())
  // 领取链接里的短码，如 /coupon/spring100。刻意不用自增 id：
  // 自增 id 可被遍历，别人能扫出所有在办的活动
  code       String    @unique @db.VarChar(32)
  name       String    @db.VarChar(80) // 后台展示用，如「双十一无门槛」
  // THRESHOLD 满减券 | PRODUCT 商品券
  kind       String    @default("THRESHOLD") @db.VarChar(20)
  // 满减：订单满 minAmount 减 discount。minAmount=0 即无门槛
  // 商品券：minAmount 无意义，discount 是对指定商品的减免额
  minAmount  Decimal   @default(0) @map("min_amount") @db.Decimal(10, 2)
  discount   Decimal   @db.Decimal(10, 2)
  // 商品券限定的商品 id，逗号分隔。为空表示不限商品（满减券就是这种）
  productIds String?   @map("product_ids") @db.VarChar(500)
  total      Int // 发行数量
  claimed    Int       @default(0) // 已领数量，原子自增
  // 有效期。两个都为空 = 长期有效
  startAt    DateTime? @map("start_at")
  endAt      DateTime? @map("end_at")
  // ACTIVE 可领可用 | PAUSED 停止发放（已领的仍可用）| ENDED 作废（已领的一并失效）
  status     String    @default("ACTIVE") @db.VarChar(20)
  note       String?   @db.VarChar(300)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  grants CouponGrant[]
  claims CouponClaim[]

  @@index([status, endAt])
  @@map("coupons")
}

// 用户领到的券实例。这是「一张券」的真正载体，状态机也在这一层
model CouponGrant {
  id          Int       @id @default(autoincrement())
  couponId    Int       @map("coupon_id")
  userId      Int       @map("user_id")
  // AVAILABLE 可用 | LOCKED 已锁定（挂在某张待支付订单上）| USED 已核销
  // | EXPIRED 已过期 | VOID 已作废（管理员操作或批次被 ENDED）
  state       String    @default("AVAILABLE") @db.VarChar(20)
  // 锁定/核销时关联的订单。释放时置回 null
  orderId     Int?      @map("order_id")
  lockedAt    DateTime? @map("locked_at")
  usedAt      DateTime? @map("used_at")
  // 有效期**快照**：从批次拷过来。批次后来改期不影响已经发出去的券，
  // 否则买家手里那张券的到期时间会在他不知情的情况下变动
  expiresAt   DateTime? @map("expires_at")
  // 审计用，出争议时能查到是谁在哪领的
  claimIp     String?   @map("claim_ip") @db.VarChar(64)
  claimDevice String?   @map("claim_device") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  // 每个账户对同一批次只能有一张。这是「每账户一张」的数据库级保证
  @@unique([couponId, userId])
  @@index([userId, state])
  @@index([state, expiresAt])
  @@index([orderId])
  @@map("coupon_grants")
}

// 领取限制的去重记录。
// 【为什么单独一张表而不是在 CouponGrant 上加索引】三限的口径不同：
// 账户可以直接用 [couponId, userId] 唯一约束，但 IP 与浏览器指纹不是 Grant 的属性，
// 且一个账户可能换 IP。把三个维度拍平成 (couponId, scope, value) 的唯一约束，
// 领取时在同一个事务里插三行，任一冲突即判定「已领过」——
// 这样并发领取被数据库挡住，而不是靠「先查再插」那种必然有竞态的写法。
model CouponClaim {
  id        Int      @id @default(autoincrement())
  couponId  Int      @map("coupon_id")
  // USER | IP | DEVICE
  scope     String   @db.VarChar(10)
  // 取值的哈希。IP 与设备指纹都算个人信息，落哈希不落原文
  value     String   @db.VarChar(64)
  grantId   Int?     @map("grant_id")
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, scope, value])
  @@index([grantId])
  @@map("coupon_claims")
}

// 友情链接 / 招商合作位。
//
// 【为什么一张表装两种东西】友链和招商位的字段重合度超过八成（站名、地址、logo、
// 简介、排序、状态、联系方式），真正的差别只有「要不要收钱、有没有到期时间」。
// 拆两张表意味着列表、审核、排序、回链巡检各写两遍，而后台其实是同一个审核队列
// ——申请人自己也分不清该投哪个口子。所以用 slot 区分展示位置，其余共用。
//
// 【为什么带审核状态】友链页是对外开放申请的，任何人都能提交。没有 PENDING 这一档，
// 要么关掉申请入口（那就失去了互挂的意义），要么让陌生站点直接出现在自己站上
// ——出站链接指到赌博/诈骗页面，赔上的是自己域名的信誉。
model FriendLink {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(60) // 站点名称
  url          String    @db.VarChar(300) // 站点地址，入库前统一补协议并去掉多余尾斜杠
  logo         String?   @db.VarChar(300) // 图标：本站上传的 /uploads/links/xxx 或对方的外链地址
  description  String?   @db.VarChar(200) // 一句话简介，卡片上只展示两行
  // FRIEND 普通友链（友链墙） | SPONSOR 招商位（页面顶部的赞助区，位置更显眼）
  slot         String    @default("FRIEND") @db.VarChar(16)
  // PENDING 待审核 | APPROVED 展示中 | REJECTED 已拒绝 | OFFLINE 已下线
  // 拒绝与下线分开：拒绝是「没通过」，下线是「通过过但现在不挂了」（对方撤链、站点挂了、
  // 赞助到期）。合并成一个状态就查不出「这家是不是曾经互挂过」，续约和追责都没依据。
  status       String    @default("PENDING") @db.VarChar(16)
  // ADMIN 后台手工添加 | APPLY 前台表单申请
  source       String    @default("ADMIN") @db.VarChar(10)
  // 出站链接是否加 rel="nofollow"。默认加：来路不明的申请先不给权重，
  // 确认对方是真实互链、内容干净之后再由管理员放开。招商位另有 rel="sponsored"，
  // 那是 Google 对付费链接的硬性要求，与这个开关无关、不可关闭。
  nofollow     Boolean   @default(true)
  sortOrder    Int       @default(0) @map("sort_order")
  clicks       Int       @default(0) // 前台点击数，用来判断哪家真的在给我们导流
  // 申请人联系方式（微信/QQ/邮箱，原样存），只在后台可见，绝不出现在前台接口里
  contact      String?   @db.VarChar(100)
  remark       String?   @db.VarChar(255) // 后台备注 / 拒绝理由
  // ---- 回链巡检结果：对方页面上还挂着我们吗 ----
  // null = 从未检测。互挂友链最常见的纠纷就是「对方悄悄把我们撤了」，
  // 靠人工点开一家家看根本不可持续，所以把结论落库、列表上直接标红。
  backlinkOk   Boolean?  @map("backlink_ok")
  backlinkNote String?   @map("backlink_note") @db.VarChar(255) // 检测详情：HTTP 状态 / 未找到本站域名 / 超时
  checkedAt    DateTime? @map("checked_at")
  // ---- 招商位的有效期。FRIEND 一般留空表示长期 ----
  startAt      DateTime? @map("start_at")
  endAt        DateTime? @map("end_at")
  applyIp      String?   @map("apply_ip") @db.VarChar(64) // 审计用：谁提交的申请
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // 前台只查 (status=APPROVED, slot) 再按 sortOrder 排，一条索引全覆盖
  @@index([status, slot, sortOrder])
  // 后台的待审核队列按提交时间倒序
  @@index([status, createdAt])
  @@map("friend_links")
}

// ============================================================
// 站级流量统计（2026-09-19）
// ============================================================
//
// 【为什么要自己记，而不是只看 Cloudflare】站点前面就是 Cloudflare，
// 它免费给国家、请求数、带宽、爬虫占比——那些这里不重复造。
// 自己记这一份的唯一理由是：**它和订单在同一个库里**。
// Cloudflare 永远回答不了「从 /chongzhi/chatgpt-plus 进来的人后来下单了没有」，
// 而那恰恰是判断这一轮 SEO 值不值的唯一口径。
//
// 【爬虫怎么挡】完全照 NewsView 的范式：前端停留 3 秒后 sendBeacon 上报。
// 爬虫不执行 JS，天然进不来。这也是为什么不在 middleware 里记——
// 那样记下来的一大半是 Googlebot 和各种扫描器，数字好看但没有任何意义。
//
// 【隐私】不存原始 IP。viewer_key 是 sha256(匿名 id 或 IP)，定长 64 位十六进制。
// 隐私政策里承诺技术日志保留 90 天，所以这两张表也按 90 天清理（见 /api/cron/cleanup）。

model PageView {
  id         Int      @id @default(autoincrement())
  // 归一化后的路径，不带 query。带 query 会让「同一个页面」散成无数行，
  // 而 ?ref= / ?s= 这些参数的统计价值远低于它造成的噪音
  path       String   @db.VarChar(191)
  viewerKey  String   @map("viewer_key") @db.VarChar(64)
  // 小时桶，格式 YYYY-MM-DDTHH（东八区）。去重靠它，同 NewsView
  hourBucket String   @map("hour_bucket") @db.VarChar(13)
  // 天键 YYYY-MM-DD（东八区）。单独存一列是为了按天聚合能走索引，
  // 而不是对 created_at 做函数运算——MySQL 那样用不上索引
  dayKey     String   @map("day_key") @db.VarChar(10)
  // 来源分类：search / direct / social / referral / internal
  source     String   @db.VarChar(12)
  // 搜索引擎名（source=search 时才有）：google / bing / baidu / sogou / yandex / other
  engine     String?  @db.VarChar(12)
  // 来源域名，只存 host 不存完整 URL（完整 URL 可能带别人站的隐私参数）
  refHost    String?  @map("ref_host") @db.VarChar(120)
  device     String   @db.VarChar(8) // mobile / desktop
  createdAt  DateTime @default(now()) @map("created_at")

  // 同一个人、同一个页面、同一小时只记一条。这是唯一一道不依赖客户端诚实的去重
  @@unique([path, viewerKey, hourBucket])
  @@index([dayKey])
  @@index([path, dayKey])
  @@index([source, dayKey])
  @@index([createdAt])
  @@map("page_views")
}

// 访客维度。单独一张表是为了「新访客 / 回访」和「访问深度」能直接查出来，
// 而不用对 page_views 做全表去重——那个在几十万行上会很慢。
model Visitor {
  key       String   @id @db.VarChar(64)
  firstSeen DateTime @default(now()) @map("first_seen")
  lastSeen  DateTime @updatedAt @map("last_seen")
  // 累计浏览数（去重后的）。用于判断「深度访客」
  views     Int      @default(0)
  // 首次进站落在哪个页面。做「入口页」分析用，比从 page_views 里反推便宜
  landing   String?  @db.VarChar(191)
  // 首次来源，用于「这个人当初是从哪来的」
  source    String?  @db.VarChar(12)

  @@index([firstSeen])
  @@index([lastSeen])
  @@map("visitors")
}
