generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id           Int       @id @default(autoincrement())
  phone        String?   @unique @db.VarChar(20)
  email        String?   @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  nickname     String?   @db.VarChar(50)
  avatar       String?   @db.VarChar(255)
  balance      Decimal   @default(0) @db.Decimal(10, 2)
  vipLevel     Int       @default(0) @map("vip_level")
  role         UserRole  @default(USER)
  status       Int       @default(1) // 1: 正常 0: 禁用
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  orders       Order[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

// 商品分类表
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(50)
  icon      String?   @db.VarChar(255)
  sortOrder Int       @default(0) @map("sort_order")
  status    Int       @default(1) // 1: 启用 0: 禁用
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products  Product[]

  @@map("categories")
}

// 商品表
model Product {
  id            Int       @id @default(autoincrement())
  categoryId    Int       @map("category_id")
  name          String    @db.VarChar(100)
  description   String?   @db.Text
  price         Decimal   @db.Decimal(10, 2)
  originalPrice Decimal?  @map("original_price") @db.Decimal(10, 2)
  image         String?   @db.VarChar(255)
  stock         Int       @default(-1) // -1表示无限库存
  sales         Int       @default(0)
  sortOrder     Int       @default(0) @map("sort_order")
  status        Int       @default(1) // 1: 上架 0: 下架
  features      String?   @db.Text // JSON格式存储商品特性
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  category      Category  @relation(fields: [categoryId], references: [id])
  orders        Order[]

  @@map("products")
}

// 订单表
model Order {
  id             Int           @id @default(autoincrement())
  orderNo        String        @unique @map("order_no") @db.VarChar(32)
  userId         Int           @map("user_id")
  productId      Int           @map("product_id")
  productName    String        @map("product_name") @db.VarChar(100)
  productPrice   Decimal       @map("product_price") @db.Decimal(10, 2)
  quantity       Int           @default(1)
  amount         Decimal       @db.Decimal(10, 2)
  payMethod      PayMethod?    @map("pay_method")
  payStatus      PayStatus     @default(UNPAID) @map("pay_status")
  deliveryStatus DeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryInfo   String?       @map("delivery_info") @db.Text // 交付信息（如账号密码）
  remark         String?       @db.VarChar(255)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  paidAt         DateTime?     @map("paid_at")
  deliveredAt    DateTime?     @map("delivered_at")

  user           User          @relation(fields: [userId], references: [id])
  product        Product       @relation(fields: [productId], references: [id])
  payments       Payment[]

  @@map("orders")
}

enum PayMethod {
  ALIPAY
  WECHAT
  BALANCE
}

enum PayStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  CANCELLED
}

// 支付记录表
model Payment {
  id           Int       @id @default(autoincrement())
  orderId      Int       @map("order_id")
  tradeNo      String?   @map("trade_no") @db.VarChar(64) // 第三方支付流水号
  payMethod    PayMethod @map("pay_method")
  amount       Decimal   @db.Decimal(10, 2)
  status       Int       @default(0) // 0: 待支付 1: 成功 2: 失败
  callbackData String?   @map("callback_data") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  order        Order     @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// 系统配置表
model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(50)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
