# 数据库密码（请改成强密码！例如：openssl rand -base64 32）
MYSQL_ROOT_PASSWORD=change_this_to_a_strong_password

# JWT 密钥（请改成强密钥！例如：openssl rand -base64 64）
JWT_SECRET=change_this_to_a_very_long_random_secret_key

# 应用 URL（用 IP 或域名）
# 例如：http://123.45.67.89 或 https://example.com
APP_URL=https://bigolab.com

# ============ 到期提醒功能 ============

# 定时任务密钥。`/api/cron/*` 全靠它鉴权，**必须设置且不能留空**。
#
# 【2026-09-07 的教训：这一行在线上曾经整条缺失】后果不是「任务跑不了」，而是更糟——
# 当时四个 cron 路由里有三个写的是 `if (secret) { ...校验... }`，密钥为空时整块被跳过，
# 于是 /api/cron/news、/api/cron/vmq-close、/api/cron/sms-poll **对公网完全敞开**：
# 任何人都能反复触发内容管线烧掉 LLM 预算、或干扰买家的待支付订单。实测均返回 200。
# 现已改成 lib/cron-auth 统一鉴权：密钥缺失一律拒绝（503）。宁可定时任务停摆被发现，
# 也不要接口静默敞开 —— 所以现在留空的后果是「所有定时任务 503」，会立刻暴露。
#
# 生成：openssl rand -hex 32
# 改完要重启 **app 与 cron 两个容器**（cron 启动时把它写进 /run/cron_secret）。
CRON_SECRET=change_this_to_a_random_string

# 阿里云 AccessKey（邮件 + 短信共用，建议用 RAM 子账号，仅授权 DirectMail + SMS）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-hangzhou

# 阿里云邮件推送 DirectMail
# ALIYUN_DM_ACCOUNT = 到期/营销类发信地址（控制台验证通过），如 remind@mail.bigolab.com
ALIYUN_DM_ACCOUNT=
# ALIYUN_DM_NOREPLY = 系统/触发类发信地址（注册验证码、交易通知、找回密码），如 no-reply@mail.bigolab.com
ALIYUN_DM_NOREPLY=no-reply@mail.bigolab.com
ALIYUN_DM_FROM_ALIAS=贝果科技

# 阿里云短信（签名 + 模板需在控制台审核通过）
# 模板示例：您购买的${type}订阅还剩${days}天到期，请及时续费续期。
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ============ V免签式收款（个人支付宝收款码 + SmsForwarder 通知转发）============
# 通讯密钥（随便生成一串：openssl rand -hex 24）；VMQ_WEBHOOK_TOKEN 留空时，SmsForwarder 的 token 就填这个
VMQ_KEY=change_this_to_a_random_key
# 收款订单有效期（分钟），超时自动过期、释放金额、对应订单置「已取消」
VMQ_PAY_TIMEOUT=20
# Webhook 校验 token（SmsForwarder 通知转发用）。留空则复用 VMQ_KEY
VMQ_WEBHOOK_TOKEN=
#
# 订单留言外推：买家在订单内发来消息时，POST 到此地址通知商家（留空则不推送）。
# 接收端可为自建接口 / Server酱 / Bark 等；POST body 含 text/content/desp/message 等字段。
ORDER_MSG_WEBHOOK_URL=
#
# 监控端二选一：
# A) VmqApk：https://github.com/szvone/VmqApk  服务器地址=https://bigolab.com  通讯密钥=VMQ_KEY
# B) SmsForwarder(推荐)：https://github.com/pppscn/SmsForwarder  应用通知监听 → Webhook
#    地址 https://bigolab.com/api/pay/sms-notify  方式 POST  Header Content-Type: application/json
#    Body: {"token":"<VMQ_KEY>","content":"[content]","from":"[from]","org":"[org_content]"}
#    （后台「收款监控」页有现成的可复制配置）
# 收款码图片：把你的支付宝「个人收款码」截图放到 public/vmq-alipay-qr.png

# ============ 卡密自动发货 ============
# 卡密加密密钥（AES-256-GCM）。务必设置一串随机值：openssl rand -hex 32
# ⚠️ 一旦录入卡密后请勿更改/丢失此密钥，否则已存卡密将无法解密！
CARDKEY_SECRET=change_this_to_a_long_random_secret

# ============ 短信接码 hero-sms ============
# hero-sms API key（后台获取）。服务/国家代码在商品里按商品配置。
HEROSMS_API_KEY=
# 接口地址（一般默认即可）
HEROSMS_BASE=https://hero-sms.com/stubs/handler_api.php
# 取号后等待验证码的超时（分钟），超时自动取消并标记待退款
HEROSMS_TIMEOUT_MIN=15

# ============ AI圈大事记（内容管线） ============
# 规范见 .claude/skills/ai-news-pipeline/SKILL.md。整段留空也能部署：
# 没有 LLM_API_KEY 时管线只做「抓取 + 去重」，不写摘要，不会报错也不会花钱。
#
# 供应商三选一（都兼容 OpenAI Chat Completions 格式，换供应商只改这三行）：
#   dashscope 阿里云百炼 | deepseek | glm 智谱
LLM_PROVIDER=dashscope
LLM_API_KEY=
# 下面几项留空则用 lib/llm.ts 里各供应商的默认值。
# 注意 qwen-flash / deepseek-chat 这类是「别名不是快照」，供应商可以把它重指到新版本并静默涨价，
# 生产上建议写死带版本号的具体模型名。
LLM_BASE_URL=
# 判断题（分诊 / 聚类）用的便宜模型
LLM_FAST_MODEL=
# 写作题（摘要 + 全文层）用的模型
LLM_WRITE_MODEL=
# 思考（推理链）档位：disabled | low | high | max | off（留空 = off，一个字段都不传）
#
# 【这一项对成本的影响比换模型还大】2026-09-07 从生产 ECS 实测：
#   glm-4.7        默认开思考单次输出 2534 token（含 3626 字推理链）；关掉后 476 token，
#                  质量反而更好 —— 差 5.3 倍，全是白花的钱。用 disabled。
#   glm-5.3/-flash **强制思考，关不掉**。不传这个参数会把 max_tokens 烧穿、
#                  返回截断的 JSON，三级降级全废 —— 等于管线瘫痪。用 low。
#   glm-4-plus / glm-4-flash  不认这些参数，多传会 400。用 off。
# 填错了也不会挂：代码在 400 时会就地纠正档位并重试一次（「始终思考」→ low，
# 「不认这个字段」→ off），且不占用三级降级的机会，只在日志里打一条警告。
LLM_THINKING=disabled
# 每百万 token 价格（分），只用于记账与预算闸门。
#
# 【必须到控制台核对再填，不要留空】留空会用代码里的默认值，而那是写代码时的估算、
# 不是核对过的报价。这两个数不影响调用本身，只影响记账 —— 而记账是
# NEWS_DAILY_BUDGET_CENTS 这道最后兜底的唯一依据。填小 50 倍，预算闸门就形同虚设，
# 真实花费会一路跑到供应商欠费为止。
# 供应商还会改价、也会把 glm-4-plus 这类别名重指到新版本（SKILL.md §5.4），
# 所以这是个要定期回看的数字。
# 智谱控制台：https://open.bigmodel.cn/ → 右上角「费用中心 / 定价」
# 换算：官方标 X 元/百万 token，这里填 X×100（单位是分）。例：50 元 → 5000
LLM_IN_PRICE=
LLM_OUT_PRICE=
# 每日 LLM 硬预算（分）。超了当天自动降级为「只去重、不写摘要」，而不是继续烧钱。
NEWS_DAILY_BUDGET_CENTS=300
# 境外源中继（Cloudflare Worker，必须做域名白名单，否则等于开了个公开 SSRF 代理）。
# 不配则 X / HuggingFace / DeepMind / Reddit 等源自动跳过，中文源照常产出。
NEWS_RELAY_URL=
NEWS_RELAY_TOKEN=

# ============ 企业微信群机器人通知 ============
# 站点动态（下单/支付/开票/收据/留言/库存告警/注册）推送到群机器人
# 企业微信群 → 右上角 → 群机器人 → 添加 → 复制 Webhook 地址
#
# 留空即可：代码会自动回落到下面的 ORDER_MSG_WEBHOOK_URL（原来订单留言用的那个地址）。
# 只有当你想给「站点动态」单独换一个群时，才需要在这里填另一个地址。
WECOM_WEBHOOK_URL=
# 只推指定事件（逗号分隔，留空=全推）。可选值：
#   order.created / order.paid / order.delivered / invoice.submitted / invoice.paid
#   receipt.created / message.buyer / stock.low / user.registered
NOTIFY_EVENTS=
# 自动发货商品剩余卡密低于该值时告警，默认 3
LOW_STOCK_THRESHOLD=3


# 上传目录总量上限（MB），防止写满磁盘连带打挂 MySQL。默认 1536
UPLOAD_MAX_TOTAL_MB=1536

# 快捷回复链接的有效期（天）。企业微信留言通知里会带一条免登录回复链接，
# 令牌只对单张订单有效、只能读该订单留言并回一条，过期自动失效。默认 7 天
QUICK_REPLY_TTL_DAYS=7
# 财务开票台链接有效期（天）。该页面会展示所有待开发票的抬头与税号，
# 比订单对话敏感，链接不宜长期漂在聊天记录里。默认 3 天
FINANCE_LINK_TTL_DAYS=3
# 是否抓取原文正文作为摘要素材（默认开）。关掉后摘要质量会明显下降——
# 素材只剩 feed 给的一两句话，模型写不出原文里没有的细节。
# 抓正文只用于「读懂」，输出仍是自写摘要 + 外链原文，不落库、不展示原文。
NEWS_FETCH_BODY=1
# 每个事件最多抓几篇原文（1-5，默认 3）
NEWS_BODY_SOURCES=3
# 分诊一次判断几条（默认 3）。模型越弱越要调小——glm-4-flash 给 8 条时只答第一条
NEWS_TRIAGE_BATCH=3
# 是否给「老事件」补写全文层 detail（默认关，填 1 开启）。
#
# 新事件的 detail 跟着摘要一起写，不受这个开关影响；这个开关只管**存量事件的回填**。
# 【默认关的原因】回填是唯一会成批调用写作模型的通道。开之前必须先把上面的
# LLM_IN_PRICE / LLM_OUT_PRICE 按控制台实际单价填好，否则你看到的当日花费是假的。
# 开启后仍有三道闸：每轮最多 2 条、当日花费超过预算 40% 就停、单条最多重试 3 次。
# 观察 /admin/news 的「待写全文」计数判断进度。
NEWS_DETAIL_BACKFILL=0

# ============================================================
# SEO
# ============================================================
# 【这三个必须同时出现在 docker-compose.yml 的 app 服务 environment: 里】
# --env-file 只负责 compose 文件里的变量替换，不会自动把变量注入容器。
# 漏了那一步的表现是「静默失效」：这里明明配了，验证 meta 就是不输出，
# IndexNow 永远推 0 条，而且没有任何报错。
#
# GOOGLE_SITE_VERIFICATION —— Google Search Console 的归属验证串。
#   取法：Search Console → 添加「网址前缀」资源（填 https://bigolab.com）
#        → 选「HTML 标记」→ 复制 content="..." 引号里的那一串，填到下面。
#   配完重新 build + up，然后回 Search Console 点「验证」。
#
#   【这是目前最要紧的一件事，而且只能由站长本人做】没有验证就没有 Search Console，
#   意味着：看不到自己被搜什么词进来、看不到收录了多少页、
#   没法主动请求索引新页面、页面被判垃圾内容时收不到任何通知。
#   所有 SEO 改动的效果都无从衡量——只能靠猜。
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools 的 msvalidate.01。可以直接从 Search Console 导入，
# 要手动验证就填这里
BING_SITE_VERIFICATION=
# 百度搜索资源平台的 baidu-site-verification（站点管理 → 添加网站 → HTML 标签验证）。
# 注意：未备案站点在百度这边有硬限制，sitemap 每日提交上限被压到 1 个。
BAIDU_SITE_VERIFICATION=
# 百度「普通收录」主动推送（scripts/baidu-push.ts 用，运行时不读）。
# BAIDU_PUSH_SITE 必须与百度站点管理里注册的形式**完全一致**：
# www 与裸域在百度那边算两个站点，形式不对会被 not_same_site 拒掉。
# 本站 canonical 是裸域，所以这里也该是裸域——前提是先把裸域注册并验证。
# BAIDU_PUSH_TOKEN 是准入密钥，接口只有 http，token 会明文出现在请求行里（百度的限制）。
BAIDU_PUSH_SITE=
BAIDU_PUSH_TOKEN=
# IndexNow 推送密钥（8-128 位十六进制）。注意：**Google 不支持这个协议**，
# 支持方是 Bing / Yandex / Seznam / Naver。它解决的是「必应几分钟收录」
INDEXNOW_KEY=
# 薄新闻页（没有全文层 detail 的）是否加 noindex。默认开启，填 0 才关闭。
# 详见 src/lib/news/thin.ts。关掉之前先想清楚：
# 749 条新闻页占 sitemap 的 97%，其中约 2/3 是每小时批量产出的 147 字 AI 摘要，
# 这组特征正对着 Google 的 scaled content abuse，而那类判定是**站点级**的，
# 真被判定时跟着掉下去的是商品页和充值落地页。
NEWS_THIN_NOINDEX=1
