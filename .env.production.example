# 数据库密码（请改成强密码！例如：openssl rand -base64 32）
MYSQL_ROOT_PASSWORD=change_this_to_a_strong_password

# JWT 密钥（请改成强密钥！例如：openssl rand -base64 64）
JWT_SECRET=change_this_to_a_very_long_random_secret_key

# 应用 URL（用 IP 或域名）
# 例如：http://123.45.67.89 或 https://example.com
APP_URL=https://bigolab.com

# ============ 到期提醒功能 ============

# 定时任务密钥（cron 容器调用提醒接口时校验，随便生成一串：openssl rand -hex 24）
CRON_SECRET=change_this_to_a_random_string

# 阿里云 AccessKey（邮件 + 短信共用，建议用 RAM 子账号，仅授权 DirectMail + SMS）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-hangzhou

# 阿里云邮件推送 DirectMail
# ALIYUN_DM_ACCOUNT = 到期/营销类发信地址（控制台验证通过），如 remind@mail.bigolab.com
ALIYUN_DM_ACCOUNT=
# ALIYUN_DM_NOREPLY = 系统/触发类发信地址（注册验证码、交易通知、找回密码），如 no-reply@mail.bigolab.com
ALIYUN_DM_NOREPLY=no-reply@mail.bigolab.com
ALIYUN_DM_FROM_ALIAS=贝果科技

# 阿里云短信（签名 + 模板需在控制台审核通过）
# 模板示例：您购买的${type}订阅还剩${days}天到期，请及时续费续期。
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ============ V免签式收款（个人支付宝收款码 + SmsForwarder 通知转发）============
# 通讯密钥（随便生成一串：openssl rand -hex 24）；VMQ_WEBHOOK_TOKEN 留空时，SmsForwarder 的 token 就填这个
VMQ_KEY=change_this_to_a_random_key
# 收款订单有效期（分钟），超时自动过期、释放金额、对应订单置「已取消」
VMQ_PAY_TIMEOUT=20
# Webhook 校验 token（SmsForwarder 通知转发用）。留空则复用 VMQ_KEY
VMQ_WEBHOOK_TOKEN=
#
# 订单留言外推：买家在订单内发来消息时，POST 到此地址通知商家（留空则不推送）。
# 接收端可为自建接口 / Server酱 / Bark 等；POST body 含 text/content/desp/message 等字段。
ORDER_MSG_WEBHOOK_URL=
#
# 监控端二选一：
# A) VmqApk：https://github.com/szvone/VmqApk  服务器地址=https://bigolab.com  通讯密钥=VMQ_KEY
# B) SmsForwarder(推荐)：https://github.com/pppscn/SmsForwarder  应用通知监听 → Webhook
#    地址 https://bigolab.com/api/pay/sms-notify  方式 POST  Header Content-Type: application/json
#    Body: {"token":"<VMQ_KEY>","content":"[content]","from":"[from]","org":"[org_content]"}
#    （后台「收款监控」页有现成的可复制配置）
# 收款码图片：把你的支付宝「个人收款码」截图放到 public/vmq-alipay-qr.png

# ============ 卡密自动发货 ============
# 卡密加密密钥（AES-256-GCM）。务必设置一串随机值：openssl rand -hex 32
# ⚠️ 一旦录入卡密后请勿更改/丢失此密钥，否则已存卡密将无法解密！
CARDKEY_SECRET=change_this_to_a_long_random_secret

# ============ 短信接码 hero-sms ============
# hero-sms API key（后台获取）。服务/国家代码在商品里按商品配置。
HEROSMS_API_KEY=
# 接口地址（一般默认即可）
HEROSMS_BASE=https://hero-sms.com/stubs/handler_api.php
# 取号后等待验证码的超时（分钟），超时自动取消并标记待退款
HEROSMS_TIMEOUT_MIN=15
