# 数据库密码（请改成强密码！例如：openssl rand -base64 32）
MYSQL_ROOT_PASSWORD=change_this_to_a_strong_password

# JWT 密钥（请改成强密钥！例如：openssl rand -base64 64）
JWT_SECRET=change_this_to_a_very_long_random_secret_key

# 应用 URL（用 IP 或域名）
# 例如：http://123.45.67.89 或 https://example.com
APP_URL=https://bigolab.com

# ============ 到期提醒功能 ============

# 定时任务密钥（cron 容器调用提醒接口时校验，随便生成一串：openssl rand -hex 24）
CRON_SECRET=change_this_to_a_random_string

# 阿里云 AccessKey（邮件 + 短信共用，建议用 RAM 子账号，仅授权 DirectMail + SMS）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-hangzhou

# 阿里云邮件推送 DirectMail
# ALIYUN_DM_ACCOUNT = 控制台「发信地址」里验证通过的地址，如 notice@mail.bigolab.com
ALIYUN_DM_ACCOUNT=
ALIYUN_DM_FROM_ALIAS=贝果科技

# 阿里云短信（签名 + 模板需在控制台审核通过）
# 模板示例：您购买的${type}订阅还剩${days}天到期，请及时续费续期。
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
