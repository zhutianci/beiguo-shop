# 数据库连接
DATABASE_URL="mysql://root:password@localhost:3306/ai_service_shop"

# JWT密钥
JWT_SECRET="your-jwt-secret-key-change-this-in-production"

# 应用配置
NEXT_PUBLIC_APP_NAME="AI服务商城"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# V免签式收款（个人支付宝收款码 + SmsForwarder 通知转发）
VMQ_KEY=""
VMQ_PAY_TIMEOUT="20"
VMQ_WEBHOOK_TOKEN=""
# 订单留言外推：买家发来消息时 POST 到此地址通知商家（留空则不推送）
ORDER_MSG_WEBHOOK_URL=""

# 卡密自动发货：AES 加密密钥（务必设置且勿丢失）
CARDKEY_SECRET=""

# 对外发卡（共用库存）API 鉴权密钥：外部站点凭此 Bearer token 调 /api/inventory/*
# 至少 16 位随机串；留空则该接口整体关闭。生成：openssl rand -hex 32
DISPENSE_API_SECRET=""
